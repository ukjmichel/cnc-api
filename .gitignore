# --- Node / Package Managers ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Keep lockfiles committed for reproducible builds
# DO NOT ignore: package-lock.json / yarn.lock / pnpm-lock.yaml

# --- TypeScript build artifacts ---
dist/
*.tsbuildinfo

# --- Environment files ---
.env
.env.*
!.env.example

# --- Logs & PIDs ---
logs/
*.log
pids/
*.pid
*.seed
*.pid.lock

# PM2 (if you ever generate local configs/logs)
.pm2/
ecosystem.config.* 

# --- Testing / Coverage ---
coverage/
.nyc_output/

# --- Temp files ---
tmp/
temp/
*.tmp
*.temp

# --- OS / Editor junk ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.code-workspace
*.swp
*.swo
.history/

# --- Swagger/OpenAPI (if generated) ---
swagger.json
openapi.json

# --- Docker (keep Dockerfile & compose tracked) ---
# Local data directories (if you ever create them)
docker-data/
